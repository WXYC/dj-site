# dj-site environment variables. Copy to `.env.local` for development.
# All NEXT_PUBLIC_* vars are inlined at build time and visible in the browser.

# Backend-Service base URLs
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:8082/auth

# Auto-DJ orchestrator base URL. When set, the dashboard polls /api/auto-dj/status
# and reflects auto-DJ state (greyscale theme + "Auto DJ Enabled" banner). Leave
# unset to disable the indicator entirely (no polling).
# NEXT_PUBLIC_ORCHESTRATOR_URL=http://localhost:8090

# Optional server-side override for the /auth/:path* rewrite destination. Set
# this in containerized deployments where NEXT_PUBLIC_BETTER_AUTH_URL is
# reachable from the browser but not from inside the dj-site server process
# (e.g. docker compose). Falls back to NEXT_PUBLIC_BETTER_AUTH_URL when unset.
# AUTH_REWRITE_URL=http://auth:8082/auth

# Optional server-only debug flag. Set to 1 to log per-phase SSR auth timing
# ([server_timing] lines: getSession, org-role) to the server / Cloudflare
# Workers Logs for a cold-load measurement window. Off (any other value) by
# default — zero cost on the hot authenticated path. Not NEXT_PUBLIC_ (never
# inlined into the client bundle).
# SERVER_TIMING=1

# Optional, server-only — better-auth organization slug/ID, used only as a
# fallback for admin-only organization.listMembers lookups when a session's
# WXYC tier can't be read from its JWT. Role resolution always tries the JWT
# first regardless of this variable. Unset everywhere today, including
# Cloudflare Pages production — the JWT path alone is sufficient, so this
# fallback never fires in any deployed environment.
# APP_ORGANIZATION=wxyc

# Optional — the client-side counterpart, same JWT-first fallback role for
# AuthorizedView. Its `globalThis.process?.env` read is never build-inlined,
# so from the browser this is always unresolved too, regardless of what's
# configured. Unlike APP_ORGANIZATION above, though, this variable IS set in
# Cloudflare Pages production: the admin roster page reads it directly,
# server-side, as the organization slug for listing/provisioning DJs — an
# unrelated, load-bearing use. See docs/env-vars.md.
# NEXT_PUBLIC_APP_ORGANIZATION=wxyc

# Routing / experience system
NEXT_PUBLIC_DASHBOARD_HOME_PAGE=/dashboard/catalog
NEXT_PUBLIC_DEFAULT_EXPERIENCE=modern
NEXT_PUBLIC_ENABLED_EXPERIENCES=modern,classic
NEXT_PUBLIC_ALLOW_EXPERIENCE_SWITCHING=true

# Catalog Track Search v2: gates two UI surfaces — `matched_via` track-match
# chips in result rows (classic + modern) and the classic SearchForm help-text
# refresh with the worked track-lookup example. Defaults to OFF; set to `true`
# (or `1`) after Backend-Service is serving matched_via in prod. See
# WXYC/dj-site#497 and WXYC/dj-site#498.
NEXT_PUBLIC_CATALOG_TRACK_SEARCH_UI_ENABLED=false

# Classic librarian navigation: gates the card-catalog admin, missing-releases,
# and rotation entries in the classic nav bar. The screens stay URL-reachable
# and server-gated regardless — this controls discoverability only, never
# authority. ON: the librarian who does the cataloguing navigates by clicking,
# so an unlinked screen is not a delivered screen, and Missing Releases has no
# other inbound link anywhere in the app. Known cost, accepted rather than
# hidden: the Rotation entry points at a route no page owns in either slot and
# 404s until WXYC/dj-site#1171 lands. See WXYC/dj-site#1163.
NEXT_PUBLIC_CLASSIC_LIBRARIAN_NAV_ENABLED=true

# Live Updates (SSE): gates dj-site's subscription to Backend-Service's
# liveFs SSE topic. Two independent flags so dashboards (small, known
# audience) can roll out before /live (unknown public audience). Both
# default OFF; flip to `true` (or `1`) per surface once Backend-Service's
# GET /events/stream endpoint is live and the connection-count metric is
# being observed. See docs/live-updates-sse.md.
NEXT_PUBLIC_FLOWSHEET_SSE_DASHBOARD_ENABLED=false
NEXT_PUBLIC_FLOWSHEET_SSE_LIVE_VIEW_ENABLED=false

# PostHog: product analytics plus its own $exception error stream. Both vars
# are optional; if NEXT_PUBLIC_POSTHOG_KEY is unset, initTelemetry()
# short-circuits and every capture is a no-op (see lib/posthog.ts). Set as
# GitHub repo variables for deployed builds — local dev rarely needs it. Host
# defaults to https://us.i.posthog.com when unset.
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry error triage (lib/sentry.ts). Errors report to BOTH Sentry and
# PostHog via lib/error-reporting.ts — see docs/adr/0008. All three vars are
# optional; without the DSN the Sentry sink is inert (PostHog still receives
# the error) and every safeCaptureException call is a no-op. The DSN is public
# identifier (it ships in the client bundle), not a secret. ENVIRONMENT
# defaults to "development" outside production builds; CI sets it to
# production/preview per deploy job. RELEASE is CI-only (set to the commit SHA
# in ci.yml) — leave it unset locally.
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.us.sentry.io/<project>
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# NEXT_PUBLIC_SENTRY_RELEASE=
